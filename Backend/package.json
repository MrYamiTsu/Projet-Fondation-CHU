{
  "name": "express-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Base de projet Express.js en JavaScript avec modules ES.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env --env-file-if-exists=.env src/server.mjs",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/server.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
