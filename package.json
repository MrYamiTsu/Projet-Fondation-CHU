{
  "name": "projet-fondation-chu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix client install --include=dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "build": "npm --prefix client run build && node -e \"const fs=require('fs'); try{if(fs.existsSync('dist')&&!fs.existsSync('client/dist')){fs.cpSync('dist','client/dist',{recursive:true})}if(fs.existsSync('client/dist')&&!fs.existsSync('dist')){fs.cpSync('client/dist','dist',{recursive:true})}}catch(e){}\"",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "server:dev": "npm --prefix Backend run dev",
    "server:start": "npm --prefix Backend start",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:start\" \"npm run client:dev\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}